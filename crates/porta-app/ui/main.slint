// M5.1: transport + tape counter. M5.2: track strips (arm/fader/pan) +
// master + meters. Undo/save/export UI arrives in M5.3.

import { Button, Slider, LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";

// Every button here is meant to be pressed by a finger on a small
// touchscreen (the Pi kiosk display), not just clicked with a mouse -
// std-widgets' default Button is sized for the latter. min-height/
// font-size are the only overrides; everything else (text, clicked,
// enabled) still comes straight from Button.
component TactileButton inherits Button {
    min-height: 46px;
    min-width: 46px;
}

// A vertical meter bar: a fixed-height track with a bottom-anchored
// fill. `level-fraction` is pre-clamped to 0..1 in Rust - no math here.
// Deliberately not theme-linked: a VU meter's own housing reads as
// dark hardware regardless of room lighting, same as the real thing -
// only the window chrome around it should follow light/dark.
component MeterBar inherits Rectangle {
    in property <float> level-fraction: 0;
    width: 20px;
    height: 140px;
    background: #222;
    border-radius: 3px;

    Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: parent.height * level-fraction;
        background: level-fraction > 0.85 ? #e05252 : #4caf6d;
        border-radius: 3px;
    }
}

component TrackStrip inherits Rectangle {
    in property <string> track-label: "1";
    in property <bool> armed: false;
    in property <float> fader-db: 0;
    in property <float> pan: 0;
    in property <float> meter-fraction: 0;

    callback arm-pressed();
    callback fader-changed(float);
    callback pan-changed(float);

    width: 104px;
    background: Palette.alternate-background;
    border-radius: 6px;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        alignment: start;

        Text {
            text: "Track " + track-label;
            horizontal-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
        }
        TactileButton {
            text: armed ? "ARMED" : "arm";
            clicked => { arm-pressed(); }
        }
        // Meter and fader side by side, like a real channel strip -
        // the fader's own travel tells you the gain at a glance
        // instead of a separate small horizontal slider underneath.
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            MeterBar { level-fraction: meter-fraction; }
            Slider {
                orientation: vertical;
                height: 140px;
                // Unity (0dB) sits at 3/4 of the travel up from the
                // bottom, not dead center or at the top: (0 - -36) /
                // (12 - -36) = 0.75. Below unity is all cut, down to
                // -36dB (effectively silent); above is up to +12dB of
                // real gain for a hot but usably weak input signal.
                minimum: -36;
                maximum: 12;
                value: fader-db;
                changed(v) => { fader-changed(v); }
            }
        }
        Text {
            text: "pan";
            horizontal-alignment: center;
            font-size: 9px;
            color: gray;
        }
        Slider {
            minimum: -1;
            maximum: 1;
            value: pan;
            changed(v) => { pan-changed(v); }
        }
    }
}

export component MainWindow inherits Window {
    title: "openporta";
    // preferred-* (not width/height) so the window manager can resize
    // and maximize it - a plain width/height binding pins the window to
    // a fixed size and maximize becomes a no-op. min-* keeps a maximized
    // or shrunk window from squeezing the track strips unreadably thin.
    // preferred-height matches the Pi kiosk display's own 800x480
    // (confirmed on-device via wlr-randr); the ScrollView below covers
    // anything still too tall to fit, on that screen or a smaller one.
    preferred-width: 620px;
    preferred-height: 480px;
    min-width: 480px;
    min-height: 280px;
    // Driven by `--kiosk` on the CLI (default false, so a plain
    // desktop launch stays a normal resizable/movable window). Both
    // are built-in Window properties - full-screen also respects the
    // SLINT_FULLSCREEN env var on its own, no-frame is winit-only.
    // in-out (not in) so the Escape handler below can also flip it -
    // kiosk mode removes every bit of window chrome, so without an
    // escape hatch there would be no way to get back to the desktop
    // short of killing the process over ssh.
    in-out property <bool> kiosk-mode: false;
    full-screen: kiosk-mode;
    no-frame: kiosk-mode;
    background: Palette.background;

    callback play-pressed();
    callback stop-pressed();
    callback record-pressed();
    callback seek-start-pressed();
    callback seek-end-pressed();
    callback rewind-pressed();
    callback fast-forward-pressed();
    callback master-fader-changed(float);
    callback save-pressed();
    callback undo-pressed();
    callback export-pressed();
    callback export-mp3-pressed();
    callback new-pressed();
    callback load-pressed();
    callback connect-pressed();
    callback disconnect-pressed();
    // Re-scans available devices - called when Settings opens, so a
    // device plugged in after launch still shows up without a restart.
    callback refresh-devices-pressed();

    in property <string> transport-state: "Stopped";
    in property <string> counter-text: "00:00";
    in property <float> master-fader-db: 0;
    in property <float> master-meter-l-fraction: 0;
    in property <float> master-meter-r-fraction: 0;
    in property <bool> can-undo: false;
    in property <string> status-text: "";
    // The currently open cassette's directory - also where New/Load
    // read the path to act on when their buttons are pressed.
    in-out property <string> cassette-path: "";
    // Real device names from cpal, "(default)" standing in for "leave
    // this blank" - a free-text field let a typo'd or unplugged device
    // name "succeed" silently against a useless fallback (found
    // 2026-08-21); a dropdown of what's actually there can't do that.
    in property <[string]> input-device-names: ["(default)"];
    in property <[string]> output-device-names: ["(default)"];
    in-out property <string> input-device-text: "(default)";
    in-out property <string> output-device-text: "(default)";
    in-out property <string> period-text: "256";
    in-out property <string> channel-offset-text: "0";
    in property <bool> connected: false;
    in property <string> connection-status: "not connected - silent, no real audio";
    in-out property <bool> show-settings: false;
    // Punch-in/out has no dedicated UI of its own (REQ-306's crossfade
    // is baked into the engine, transport.rs): arm a track, hit Record
    // while Playing to punch in; Play again punches out and keeps
    // rolling, Stop punches out and halts - the same buttons above.
    in-out property <string> export-path: "export.wav";

    // Aliases so Rust can read/set each strip's state and connect its
    // callbacks from the root - the strips themselves are instantiated
    // once, in place, in the layout below.
    in property <bool> track1-armed <=> track1.armed;
    in property <float> track1-fader-db <=> track1.fader-db;
    in property <float> track1-pan <=> track1.pan;
    in property <float> track1-meter-fraction <=> track1.meter-fraction;
    callback track1-arm-pressed <=> track1.arm-pressed;
    callback track1-fader-changed <=> track1.fader-changed;
    callback track1-pan-changed <=> track1.pan-changed;

    in property <bool> track2-armed <=> track2.armed;
    in property <float> track2-fader-db <=> track2.fader-db;
    in property <float> track2-pan <=> track2.pan;
    in property <float> track2-meter-fraction <=> track2.meter-fraction;
    callback track2-arm-pressed <=> track2.arm-pressed;
    callback track2-fader-changed <=> track2.fader-changed;
    callback track2-pan-changed <=> track2.pan-changed;

    in property <bool> track3-armed <=> track3.armed;
    in property <float> track3-fader-db <=> track3.fader-db;
    in property <float> track3-pan <=> track3.pan;
    in property <float> track3-meter-fraction <=> track3.meter-fraction;
    callback track3-arm-pressed <=> track3.arm-pressed;
    callback track3-fader-changed <=> track3.fader-changed;
    callback track3-pan-changed <=> track3.pan-changed;

    in property <bool> track4-armed <=> track4.armed;
    in property <float> track4-fader-db <=> track4.fader-db;
    in property <float> track4-pan <=> track4.pan;
    in property <float> track4-meter-fraction <=> track4.meter-fraction;
    callback track4-arm-pressed <=> track4.arm-pressed;
    callback track4-fader-changed <=> track4.fader-changed;
    callback track4-pan-changed <=> track4.pan-changed;

    // Escape leaves kiosk mode (window chrome and normal size come
    // back) - the only way out of it besides killing the process over
    // ssh, since --kiosk otherwise removes every bit of window chrome
    // a mouse could use to do that. init grabs focus immediately so
    // the very first keypress works, not just after a click.
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && kiosk-mode) {
                kiosk-mode = false;
                accept
            } else {
                reject
            }
        }
        init => { self.focus(); }

        ScrollView {
            visible: show-settings;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                Text {
                    text: "Settings";
                    font-size: 18px;
                    color: Palette.foreground;
                }

                Text {
                    text: "Input device";
                    font-size: 11px;
                    color: gray;
                }
                ComboBox {
                    model: input-device-names;
                    current-value <=> input-device-text;
                }

                Text {
                    text: "Output device";
                    font-size: 11px;
                    color: gray;
                }
                ComboBox {
                    model: output-device-names;
                    current-value <=> output-device-text;
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Period (frames)"; font-size: 11px; color: gray; }
                        LineEdit { text <=> period-text; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Input channel offset"; font-size: 11px; color: gray; }
                        LineEdit { text <=> channel-offset-text; }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    TactileButton {
                        text: connected ? "Disconnect" : "Connect";
                        clicked => {
                            if (connected) {
                                disconnect-pressed();
                            } else {
                                connect-pressed();
                            }
                        }
                    }
                    TactileButton {
                        text: "Refresh devices";
                        clicked => { refresh-devices-pressed(); }
                    }
                    TactileButton {
                        text: "Back";
                        clicked => { show-settings = false; }
                    }
                }
                Text {
                    text: connection-status;
                    font-size: 11px;
                    color: gray;
                }

                Text {
                    text: "Display";
                    font-size: 11px;
                    color: gray;
                }
                TactileButton {
                    text: kiosk-mode ? "Exit kiosk mode" : "Enter kiosk mode";
                    clicked => { kiosk-mode = !kiosk-mode; }
                }
            }
        }

        // Scrollable so the full layout stays reachable on a short
        // window (an 800x480 kiosk display, or this window shrunk/
        // maximized to something the content doesn't natively fit)
        // instead of clipping silently off the bottom edge.
        ScrollView {
            visible: !show-settings;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> cassette-path;
                    }
                    TactileButton { text: "New"; clicked => { new-pressed(); } }
                    TactileButton { text: "Load"; clicked => { load-pressed(); } }
                    TactileButton {
                        text: "⚙";
                        clicked => {
                            show-settings = true;
                            refresh-devices-pressed();
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: counter-text;
                        font-size: 22px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                    Text {
                        text: transport-state;
                        font-size: 13px;
                        color: gray;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    TactileButton { text: "|<"; clicked => { seek-start-pressed(); } }
                    TactileButton { text: "<<"; clicked => { rewind-pressed(); } }
                    TactileButton { text: "Play"; clicked => { play-pressed(); } }
                    TactileButton { text: "Stop"; clicked => { stop-pressed(); } }
                    TactileButton { text: "Record"; clicked => { record-pressed(); } }
                    TactileButton { text: ">>"; clicked => { fast-forward-pressed(); } }
                    TactileButton { text: ">|"; clicked => { seek-end-pressed(); } }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    track1 := TrackStrip { track-label: "1"; }
                    track2 := TrackStrip { track-label: "2"; }
                    track3 := TrackStrip { track-label: "3"; }
                    track4 := TrackStrip { track-label: "4"; }

                    Rectangle {
                        width: 104px;
                        background: Palette.alternate-background;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "Master";
                                horizontal-alignment: center;
                                font-size: 12px;
                                color: Palette.foreground;
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                MeterBar { level-fraction: master-meter-l-fraction; }
                                MeterBar { level-fraction: master-meter-r-fraction; }
                                Slider {
                                    orientation: vertical;
                                    height: 140px;
                                    minimum: -36;
                                    maximum: 12;
                                    value: master-fader-db;
                                    changed(v) => { master-fader-changed(v); }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    TactileButton { text: "Save"; clicked => { save-pressed(); } }
                    TactileButton {
                        text: "Undo";
                        enabled: can-undo;
                        clicked => { undo-pressed(); }
                    }
                    LineEdit {
                        width: 140px;
                        text <=> export-path;
                    }
                    TactileButton { text: "Export WAV"; clicked => { export-pressed(); } }
                    TactileButton { text: "Export MP3"; clicked => { export-mp3-pressed(); } }
                }
                Text {
                    text: status-text;
                    horizontal-alignment: center;
                    font-size: 10px;
                    color: gray;
                }
            }
        }
    }
}
