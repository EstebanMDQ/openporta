// M5.1: transport + tape counter. M5.2: track strips (arm/fader/pan) +
// master + meters. Undo/save/export UI arrives in M5.3.

import { Slider, LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";

// Every button here is meant to be pressed by a finger on a small
// touchscreen (the Pi kiosk display), not just clicked with a mouse -
// std-widgets' default Button is sized and colored for the latter, and
// doesn't expose enough (no font-size, no background) to restyle for
// contrast or a meaningful "on" state, so this is a plain Rectangle +
// TouchArea instead. `active`/`active-color` give arm/mute/monitor/
// transport buttons a real, solid highlight color (red for armed/
// muted/recording, blue for monitoring, green for playing) instead of
// a generic theme accent.
component TactileButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> active-color: Palette.accent-background;
    out property <bool> pressed: touch.pressed;
    callback clicked();

    min-height: 46px;
    min-width: 46px;
    border-radius: 6px;
    border-width: active ? 0px : 1px;
    border-color: Palette.border;
    background: active
        ? (touch.pressed ? active-color.darker(0.15) : active-color)
        : (touch.pressed ? Palette.alternate-background : Palette.control-background);
    opacity: enabled ? 1.0 : 0.5;

    animate background { duration: 100ms; }

    Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 14px;
        color: active ? white : Palette.foreground;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A vertical meter bar: a fixed-height track with a bottom-anchored
// fill. `level-fraction` is pre-clamped to 0..1 in Rust - no math here.
// Deliberately not theme-linked: a VU meter's own housing reads as
// dark hardware regardless of room lighting, same as the real thing -
// only the window chrome around it should follow light/dark.
component MeterBar inherits Rectangle {
    in property <float> level-fraction: 0;
    width: 20px;
    // Matches the fader Slider's own height below it - shortened from
    // 140px so the mixer screen fits the 800x480 kiosk display without
    // scrolling (still a real vertical throw, just not the maximum
    // that alone would fit).
    height: 90px;
    background: #222;
    border-radius: 3px;

    Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: parent.height * level-fraction;
        background: level-fraction > 0.85 ? #e05252 : #4caf6d;
        border-radius: 3px;
    }
}

component TrackStrip inherits Rectangle {
    in property <string> track-label: "1";
    in property <bool> armed: false;
    in property <bool> muted: false;
    in property <bool> monitor: false;
    in property <float> fader-db: 0;
    in property <float> pan: 0;
    in property <float> meter-fraction: 0;

    callback arm-pressed();
    callback mute-pressed();
    callback monitor-pressed();
    callback fader-changed(float);
    callback pan-changed(float);

    width: 116px;
    background: Palette.alternate-background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 4px;
        spacing: 3px;
        alignment: start;

        Text {
            text: "Track " + track-label;
            horizontal-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
        }
        TactileButton {
            text: armed ? "ARMED" : "arm";
            active: armed;
            active-color: #e05252;
            clicked => { arm-pressed(); }
        }
        HorizontalLayout {
            spacing: 4px;
            TactileButton {
                text: muted ? "MUTED" : "mute";
                active: muted;
                active-color: #e05252;
                clicked => { mute-pressed(); }
            }
            TactileButton {
                text: monitor ? "MON" : "mon";
                active: monitor;
                active-color: #4a90d9;
                clicked => { monitor-pressed(); }
            }
        }
        // Meter and fader side by side, like a real channel strip -
        // the fader's own travel tells you the gain at a glance
        // instead of a separate small horizontal slider underneath.
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            MeterBar { level-fraction: meter-fraction; }
            Slider {
                orientation: vertical;
                height: 90px;
                // Unity (0dB) sits at 3/4 of the travel up from the
                // bottom, not dead center or at the top: (0 - -36) /
                // (12 - -36) = 0.75. Below unity is all cut, down to
                // -36dB (effectively silent); above is up to +12dB of
                // real gain for a hot but usably weak input signal.
                minimum: -36;
                maximum: 12;
                value: fader-db;
                changed(v) => { fader-changed(v); }
            }
        }
        // No "pan" label - screen space is tight enough on the kiosk
        // display that the slider's own center-detent position (0 -
        // straight up the middle) is left to speak for itself.
        Slider {
            minimum: -1;
            maximum: 1;
            value: pan;
            changed(v) => { pan-changed(v); }
        }
    }
}

export component MainWindow inherits Window {
    title: "openporta";
    // preferred-* (not width/height) so the window manager can resize
    // and maximize it - a plain width/height binding pins the window to
    // a fixed size and maximize becomes a no-op. min-* keeps a maximized
    // or shrunk window from squeezing the track strips unreadably thin.
    // preferred-height matches the Pi kiosk display's own 800x480
    // (confirmed on-device via wlr-randr); the ScrollView below covers
    // anything still too tall to fit, on that screen or a smaller one.
    preferred-width: 660px;
    preferred-height: 500px;
    min-width: 480px;
    min-height: 280px;
    // Driven by `--kiosk` on the CLI (default false, so a plain
    // desktop launch stays a normal resizable/movable window). Both
    // are built-in Window properties, no-frame is winit-only.
    // in-out (not in) so the Escape handler below can also flip it -
    // kiosk mode removes every bit of window chrome, so without an
    // escape hatch there would be no way to get back to the desktop
    // short of killing the process over ssh.
    //
    // maximized, not full-screen: visually identical (edge-to-edge, no
    // chrome) on this compositor, but a true wlr fullscreen surface
    // sits above the layer-shell "top" layer an on-screen keyboard
    // (wvkbd) uses, hiding it completely - confirmed on-device
    // 2026-08-22. A maximized window doesn't claim that exclusive
    // state, so the keyboard can still show above it.
    in-out property <bool> kiosk-mode: false;
    maximized: kiosk-mode;
    no-frame: kiosk-mode;
    // Fired only by the two toggle points below (Escape, the Settings
    // button) - not by the initial `--kiosk` startup value, which the
    // launch wrapper (deploy/kiosk-launch.sh) already handles before
    // this window even opens. Lets Rust best-effort suppress/restore
    // the Pi's own desktop panel in sync with a *live* toggle, so
    // Escape's "get back to a usable desktop" actually shows one.
    callback kiosk-mode-changed(bool);
    background: Palette.background;

    callback play-pressed();
    callback stop-pressed();
    callback record-pressed();
    callback seek-start-pressed();
    callback seek-end-pressed();
    callback rewind-pressed();
    callback fast-forward-pressed();
    callback master-fader-changed(float);
    // The bounce bus (REQ-409): fader and mute, no pan.
    callback bus-fader-changed(float);
    callback bus-mute-pressed();
    callback save-pressed();
    callback undo-pressed();
    // Post-fader mono sum of tracks 1-3 onto track 4 (REQ-401) - a
    // blocking, stop-gated operation like Save/Undo, not a live Command,
    // so it's wired the same way they are.
    callback bounce-pressed();
    callback export-pressed();
    callback export-mp3-pressed();
    callback export-video-pressed();
    callback new-pressed();
    callback load-pressed();
    callback connect-pressed();
    callback disconnect-pressed();
    // Re-scans available devices - called when Settings opens, so a
    // device plugged in after launch still shows up without a restart.
    callback refresh-devices-pressed();

    in property <string> transport-state: "Stopped";
    in property <string> counter-text: "00:00";
    // Raw sample counts (not the human-readable counter-text) driving
    // the position bar below the transport row - float, not int, so
    // the fraction below doesn't truncate under integer division.
    in property <float> playhead-samples: 0;
    in property <float> tape-len-samples: 1;
    in property <float> master-fader-db: 0;
    in property <float> bus-fader-db: 0;
    in property <bool> bus-muted: false;
    /// True while a bounce pass is armed or running - the engine can
    /// clear this on its own (REQ-405), so it is mirrored from the
    /// engine rather than assumed from the last button press.
    in property <bool> bus-armed: false;
    in property <float> master-meter-l-fraction: 0;
    in property <float> master-meter-r-fraction: 0;
    in property <bool> can-undo: false;
    in property <string> status-text: "";
    // The currently open cassette's directory - also where New/Load
    // read the path to act on when their buttons are pressed.
    in-out property <string> cassette-path: "";
    // Real device names from cpal, "(default)" standing in for "leave
    // this blank" - a free-text field let a typo'd or unplugged device
    // name "succeed" silently against a useless fallback (found
    // 2026-08-21); a dropdown of what's actually there can't do that.
    in property <[string]> input-device-names: ["(default)"];
    in property <[string]> output-device-names: ["(default)"];
    in-out property <string> input-device-text: "(default)";
    in-out property <string> output-device-text: "(default)";
    in-out property <string> period-text: "256";
    // Per-track input channels, 1-based, matching what `probe` prints;
    // "-" leaves a track silent (e.g. "3,-,5,6"). Replaced the single
    // channel-offset field (change 002).
    in-out property <string> input-channels-text: "1,2,3,4";
    in property <bool> connected: false;
    in property <string> connection-status: "not connected - silent, no real audio";
    in-out property <bool> show-settings: false;
    in-out property <bool> show-tapes: false;
    // Sibling cassette directories next to the one currently open, for
    // the Tapes view's picker - re-scanned when that view opens, not
    // every tick, so plugging in a new cassette while looking at it is
    // a re-open away, not a live filesystem watch.
    in property <[string]> cassette-names: [];
    in property <string> free-space-text: "";
    callback load-tape-pressed(string);
    // Re-scans cassette-names/free-space-text - called when Tapes
    // opens, same pattern as refresh-devices-pressed for Settings.
    callback refresh-tapes-pressed();
    // Punch-in/out has no dedicated UI of its own (REQ-306's crossfade
    // is baked into the engine, transport.rs): arm a track, hit Record
    // while Playing to punch in; Play again punches out and keeps
    // rolling, Stop punches out and halts - the same buttons above.
    in-out property <string> export-path: "export.wav";
    // No default - there's no cover art to fall back to; blank means
    // "nothing picked yet," checked explicitly before shelling out.
    in-out property <string> video-image-path: "";

    // Aliases so Rust can read/set each strip's state and connect its
    // callbacks from the root - the strips themselves are instantiated
    // once, in place, in the layout below.
    in property <bool> track1-armed <=> track1.armed;
    in property <bool> track1-muted <=> track1.muted;
    in property <bool> track1-monitor <=> track1.monitor;
    in property <float> track1-fader-db <=> track1.fader-db;
    in property <float> track1-pan <=> track1.pan;
    in property <float> track1-meter-fraction <=> track1.meter-fraction;
    callback track1-arm-pressed <=> track1.arm-pressed;
    callback track1-mute-pressed <=> track1.mute-pressed;
    callback track1-monitor-pressed <=> track1.monitor-pressed;
    callback track1-fader-changed <=> track1.fader-changed;
    callback track1-pan-changed <=> track1.pan-changed;

    in property <bool> track2-armed <=> track2.armed;
    in property <bool> track2-muted <=> track2.muted;
    in property <bool> track2-monitor <=> track2.monitor;
    in property <float> track2-fader-db <=> track2.fader-db;
    in property <float> track2-pan <=> track2.pan;
    in property <float> track2-meter-fraction <=> track2.meter-fraction;
    callback track2-arm-pressed <=> track2.arm-pressed;
    callback track2-mute-pressed <=> track2.mute-pressed;
    callback track2-monitor-pressed <=> track2.monitor-pressed;
    callback track2-fader-changed <=> track2.fader-changed;
    callback track2-pan-changed <=> track2.pan-changed;

    in property <bool> track3-armed <=> track3.armed;
    in property <bool> track3-muted <=> track3.muted;
    in property <bool> track3-monitor <=> track3.monitor;
    in property <float> track3-fader-db <=> track3.fader-db;
    in property <float> track3-pan <=> track3.pan;
    in property <float> track3-meter-fraction <=> track3.meter-fraction;
    callback track3-arm-pressed <=> track3.arm-pressed;
    callback track3-mute-pressed <=> track3.mute-pressed;
    callback track3-monitor-pressed <=> track3.monitor-pressed;
    callback track3-fader-changed <=> track3.fader-changed;
    callback track3-pan-changed <=> track3.pan-changed;

    in property <bool> track4-armed <=> track4.armed;
    in property <bool> track4-muted <=> track4.muted;
    in property <bool> track4-monitor <=> track4.monitor;
    in property <float> track4-fader-db <=> track4.fader-db;
    in property <float> track4-pan <=> track4.pan;
    in property <float> track4-meter-fraction <=> track4.meter-fraction;
    callback track4-arm-pressed <=> track4.arm-pressed;
    callback track4-mute-pressed <=> track4.mute-pressed;
    callback track4-monitor-pressed <=> track4.monitor-pressed;
    callback track4-fader-changed <=> track4.fader-changed;
    callback track4-pan-changed <=> track4.pan-changed;

    // Escape leaves kiosk mode (window chrome and normal size come
    // back) - the only way out of it besides killing the process over
    // ssh, since --kiosk otherwise removes every bit of window chrome
    // a mouse could use to do that. init grabs focus immediately so
    // the very first keypress works, not just after a click.
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && kiosk-mode) {
                kiosk-mode = false;
                kiosk-mode-changed(false);
                accept
            } else {
                reject
            }
        }
        init => { self.focus(); }

        // Holding rewind/fast-forward repeats the same jump every
        // 200ms instead of just once - a quick tap fires only via
        // clicked below (well under 200ms), a hold keeps searching
        // until released. If the transport is playing at the time,
        // each 200ms window between jumps is real, audible playback -
        // a genuine (if choppy) audible scrub, not a silent jump, with
        // no new engine capability needed: it's just the existing
        // rewind/fast-forward commands fired repeatedly.
        Timer {
            interval: 200ms;
            running: rewind-btn.pressed;
            triggered => { rewind-pressed(); }
        }
        Timer {
            interval: 200ms;
            running: ff-btn.pressed;
            triggered => { fast-forward-pressed(); }
        }

        ScrollView {
            visible: show-settings;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                Text {
                    text: "Settings";
                    font-size: 18px;
                    color: Palette.foreground;
                }

                Text {
                    text: "Input device";
                    font-size: 11px;
                    color: gray;
                }
                ComboBox {
                    model: input-device-names;
                    current-value <=> input-device-text;
                }

                Text {
                    text: "Output device";
                    font-size: 11px;
                    color: gray;
                }
                ComboBox {
                    model: output-device-names;
                    current-value <=> output-device-text;
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Period (frames)"; font-size: 11px; color: gray; }
                        LineEdit { text <=> period-text; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Input channels"; font-size: 11px; color: gray; }
                        LineEdit {
                            text <=> input-channels-text;
                            placeholder-text: "e.g. 3,4,5,6";
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    TactileButton {
                        text: connected ? "Disconnect" : "Connect";
                        active: connected;
                        active-color: #4caf6d;
                        clicked => {
                            if (connected) {
                                disconnect-pressed();
                            } else {
                                connect-pressed();
                            }
                        }
                    }
                    TactileButton {
                        text: "Refresh devices";
                        clicked => { refresh-devices-pressed(); }
                    }
                    TactileButton {
                        text: "Back";
                        clicked => { show-settings = false; show-tapes = false; }
                    }
                }
                Text {
                    text: connection-status;
                    font-size: 11px;
                    color: gray;
                }

                Text {
                    text: "Display";
                    font-size: 11px;
                    color: gray;
                }
                TactileButton {
                    text: kiosk-mode ? "Exit kiosk mode" : "Enter kiosk mode";
                    clicked => {
                        kiosk-mode = !kiosk-mode;
                        kiosk-mode-changed(kiosk-mode);
                    }
                }
            }
        }

        // Cassette management: pick an existing tape, create a new one,
        // export/render. Off the main screen so the mixer view stays
        // short enough to fit the kiosk display without scrolling.
        ScrollView {
            visible: show-tapes;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                Text {
                    text: "Tapes";
                    font-size: 18px;
                    color: Palette.foreground;
                }
                Text {
                    text: free-space-text;
                    font-size: 11px;
                    color: gray;
                }

                Text {
                    text: "Open";
                    font-size: 11px;
                    color: gray;
                }
                for name in cassette-names: Rectangle {
                    height: 40px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: tap.pressed ? Palette.alternate-background : Palette.control-background;

                    Text {
                        text: name;
                        x: 10px;
                        vertical-alignment: center;
                        height: 100%;
                        color: Palette.foreground;
                        font-size: 12px;
                    }
                    tap := TouchArea {
                        clicked => { load-tape-pressed(name); }
                    }
                }

                Text {
                    text: "New / open by path";
                    font-size: 11px;
                    color: gray;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> cassette-path;
                    }
                    TactileButton { text: "New"; clicked => { new-pressed(); refresh-tapes-pressed(); } }
                    TactileButton { text: "Load"; clicked => { load-pressed(); } }
                }

                Text {
                    text: "Export";
                    font-size: 11px;
                    color: gray;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> export-path;
                    }
                    TactileButton { text: "Export WAV"; clicked => { export-pressed(); } }
                    TactileButton { text: "Export MP3"; clicked => { export-mp3-pressed(); } }
                }
                // A still image plus the mix, as an MP4 - ready to
                // upload anywhere that takes video. Shares export-path
                // (extension swapped to .mp4, same as MP3 swaps to
                // .mp3) - only the image needs its own field.
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> video-image-path;
                        placeholder-text: "cover image path";
                    }
                    TactileButton { text: "Export Video"; clicked => { export-video-pressed(); } }
                }

                TactileButton {
                    text: "Back";
                    clicked => { show-tapes = false; }
                }
            }
        }

        // Scrollable so the full layout stays reachable on a short
        // window (an 800x480 kiosk display, or this window shrunk/
        // maximized to something the content doesn't natively fit)
        // instead of clipping silently off the bottom edge.
        ScrollView {
            visible: !show-settings && !show-tapes;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 6px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: cassette-path;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground;
                        font-size: 12px;
                    }
                    // Spacer so the two buttons stay pinned right
                    // regardless of how long the cassette path is.
                    Rectangle { horizontal-stretch: 1; }
                    TactileButton {
                        text: "Tapes";
                        clicked => {
                            show-tapes = true;
                            show-settings = false;
                            refresh-tapes-pressed();
                        }
                    }
                    TactileButton {
                        text: "⚙";
                        clicked => {
                            show-settings = true;
                            show-tapes = false;
                            refresh-devices-pressed();
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: counter-text;
                        font-size: 22px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                    Text {
                        text: transport-state;
                        font-size: 13px;
                        color: gray;
                        vertical-alignment: center;
                    }
                }
                // How far into the tape the playhead currently is -
                // requested directly, sits right under the counter.
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Palette.alternate-background;
                    Rectangle {
                        x: 0;
                        width: parent.width
                            * clamp(tape-len-samples > 0 ? playhead-samples / tape-len-samples : 0, 0, 1);
                        height: parent.height;
                        border-radius: 3px;
                        background: Palette.accent-background;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    TactileButton { text: "|<"; clicked => { seek-start-pressed(); } }
                    rewind-btn := TactileButton { text: "<<"; clicked => { rewind-pressed(); } }
                    TactileButton {
                        text: "Play";
                        active: transport-state == "Playing";
                        active-color: #4caf6d;
                        clicked => { play-pressed(); }
                    }
                    TactileButton { text: "Stop"; clicked => { stop-pressed(); } }
                    TactileButton {
                        text: "Record";
                        active: transport-state == "Recording";
                        active-color: #e05252;
                        clicked => { record-pressed(); }
                    }
                    ff-btn := TactileButton { text: ">>"; clicked => { fast-forward-pressed(); } }
                    TactileButton { text: ">|"; clicked => { seek-end-pressed(); } }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    track1 := TrackStrip { track-label: "1"; }
                    track2 := TrackStrip { track-label: "2"; }
                    track3 := TrackStrip { track-label: "3"; }
                    track4 := TrackStrip { track-label: "4"; }

                    // The bounce bus, between the tracks and the master
                    // because that is where it sits in the signal path.
                    // Narrower than a track strip: it has no arm, no
                    // monitor and no pan (it is already stereo), which
                    // is also what keeps the row inside 800px.
                    Rectangle {
                        width: 92px;
                        background: Palette.alternate-background;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: bus-armed ? #e05252 : Palette.border;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 3px;
                            alignment: start;

                            Text {
                                text: bus-armed ? "BUS REC" : "Bus";
                                horizontal-alignment: center;
                                font-size: 12px;
                                color: bus-armed ? #e05252 : Palette.foreground;
                            }
                            TactileButton {
                                text: bus-muted ? "MUTED" : "mute";
                                active: bus-muted;
                                active-color: #e05252;
                                clicked => { bus-mute-pressed(); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                Slider {
                                    orientation: vertical;
                                    height: 90px;
                                    minimum: -36;
                                    maximum: 12;
                                    value: bus-fader-db;
                                    changed(v) => { bus-fader-changed(v); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 116px;
                        background: Palette.alternate-background;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "Master";
                                horizontal-alignment: center;
                                font-size: 12px;
                                color: Palette.foreground;
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                MeterBar { level-fraction: master-meter-l-fraction; }
                                MeterBar { level-fraction: master-meter-r-fraction; }
                                Slider {
                                    orientation: vertical;
                                    height: 90px;
                                    minimum: -36;
                                    maximum: 12;
                                    value: master-fader-db;
                                    changed(v) => { master-fader-changed(v); }
                                }
                            }
                        }
                    }
                }

                // Save/Undo and the status line share one row (instead
                // of stacking) - one less row's worth of height, part
                // of fitting the kiosk display without scrolling.
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    TactileButton { text: "Save"; clicked => { save-pressed(); } }
                    TactileButton {
                        text: "Undo";
                        enabled: can-undo;
                        clicked => { undo-pressed(); }
                    }
                    TactileButton {
                        // Reflects the engine's own bus-arm state, not
                        // the last press: the engine can clear it
                        // itself (REQ-405), and the pass ends on Stop
                        // as well as on a second press.
                        text: bus-armed ? "BOUNCING" : "Bounce";
                        active: bus-armed;
                        active-color: #e05252;
                        clicked => { bounce-pressed(); }
                    }
                    Text {
                        text: status-text;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 10px;
                        color: gray;
                    }
                }
            }
        }
    }
}
